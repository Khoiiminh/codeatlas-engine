# FND-03: contract sources and the generated package must be byte-identical on every OS,
# so the packed @codeatlas/contracts tarball is reproducible.
contracts/** text eol=lf
packages/contracts/** text eol=lf
# FND-04: fixture sources and expectations are golden (line numbers, content hashes in seeds).
tests/fixtures/** text eol=lf
*.tgz binary
# ENG-02: parser cases are kept byte for byte. Some deliberately use CRLF line endings or a
# byte order mark, and the expected positions depend on them.
crates/adapters/codeatlas-parser-treesitter/tests/cases/** -text
# ENG-03: the same for the symbol cases (expected ranges depend on the exact bytes).
crates/adapters/codeatlas-parser-treesitter/tests/symbols/** -text
