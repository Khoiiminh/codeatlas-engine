{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@/*": [
        "./web/src/*"
      ]
    }
  },
  "include": [
    "backend/src",
    "web/src",
    "sfu/src"
  ]
}
