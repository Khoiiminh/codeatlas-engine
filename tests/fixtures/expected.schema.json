{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeatlas:test-fixtures:expected:1",
  "title": "Source fixture expectations",
  "description": "What a complete analysis of a source fixture must find (FND-04). Lines are 1-based, as shown in an editor; the canonical contract uses zero-based positions, so adapters subtract 1. Ids follow the contract examples: 'file:<path>', 'symbol:<path>#<qualifiedName>' and 'external:<specifier>', where <path> is repository-relative. Conventions are listed in tests/fixtures/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture",
    "revision",
    "root",
    "files",
    "ignoredPaths",
    "externalModules",
    "symbols",
    "edges",
    "unresolved",
    "typescriptDiagnostics"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "fixture": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "revision": {
      "description": "Increase whenever the fixture source or these expectations change, so golden tests can tell which revision they were written against.",
      "type": "integer",
      "minimum": 1
    },
    "root": { "description": "Folder, relative to this file, that is the analysed repository root.", "type": "string" },
    "typescriptProjects": {
      "description": "tsconfig files, relative to this file, that the TypeScript cross-check compiles (one per package in a monorepo; a checker-only tsconfig next to this file for a plain JavaScript project). Default: <root>/tsconfig.json.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\.json$" }
    },
    "files": {
      "description": "Exhaustive inventory of analysable source files, sorted by path.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "language"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "language": { "enum": ["typescript", "tsx", "javascript", "jsx"] }
        }
      }
    },
    "ignoredPaths": {
      "description": "Folders (with trailing '/') that exist in the fixture but must not be analysed.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[^/].*/$" }
    },
    "externalModules": {
      "description": "Every external module specifier that appears as an import target.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "symbols": {
      "description": "Exhaustive list of declared symbols (module scope and class or interface members).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "path", "line", "exported"],
        "properties": {
          "id": { "$ref": "#/$defs/symbolId" },
          "kind": {
            "enum": ["namespace", "class", "interface", "type_alias", "enum", "function", "method", "property", "variable"]
          },
          "name": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/$defs/path" },
          "line": { "$ref": "#/$defs/line" },
          "parent": { "$ref": "#/$defs/symbolId" },
          "exported": { "type": "boolean" }
        }
      }
    },
    "edges": {
      "description": "Exhaustive list of resolved relationships.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "from", "to", "path", "line", "text"],
        "properties": {
          "kind": { "enum": ["imports", "exports", "calls", "references", "extends", "implements"] },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/path" },
          "line": { "$ref": "#/$defs/line" },
          "text": { "description": "Source text that appears on that line.", "type": "string", "minLength": 1 },
          "specifier": { "type": "string", "minLength": 1 },
          "typeOnly": { "const": true }
        }
      }
    },
    "unresolved": {
      "description": "Exhaustive list of relationships the analyser must report as unresolved, with the reason.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "from", "path", "line", "text", "specifier", "reason"],
        "properties": {
          "kind": { "enum": ["imports", "calls", "references"] },
          "from": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/path" },
          "line": { "$ref": "#/$defs/line" },
          "text": { "type": "string", "minLength": 1 },
          "specifier": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["not_found", "ambiguous", "dynamic", "unsupported"] }
        }
      }
    },
    "typescriptDiagnostics": {
      "description": "Exactly the diagnostics the pinned TypeScript compiler reports for the fixture's tsconfig.json.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "code"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "line": { "$ref": "#/$defs/line" },
          "code": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^[^/\\\\][^\\\\#]*$" },
    "line": { "type": "integer", "minimum": 1 },
    "symbolId": { "type": "string", "pattern": "^symbol:[^/\\\\][^\\\\#]*#[^#]+$" },
    "id": {
      "anyOf": [
        { "type": "string", "pattern": "^file:[^/\\\\][^\\\\#]*$" },
        { "$ref": "#/$defs/symbolId" },
        { "type": "string", "pattern": "^external:.+$" }
      ]
    }
  }
}
