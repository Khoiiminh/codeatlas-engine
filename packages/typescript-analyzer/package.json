{
  "name": "@codeatlas/typescript-analyzer",
  "version": "0.0.0",
  "private": true,
  "description": "Out-of-process driven adapter: TypeScript Compiler API resolution for codeatlas-semantic-typescript (ADR-0010 rule 6, ADR-0015).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "main": "./src/main.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:fixtures": "node ./scripts/check-fixtures.ts",
    "check:parser-cases": "node ./scripts/check-parser-cases.ts",
    "check:symbol-cases": "node ./scripts/check-symbol-cases.ts",
    "start": "node ./src/main.ts"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  }
}
