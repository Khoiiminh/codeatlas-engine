// Generates the TypeScript side of the contracts from contracts/schemas/codeatlas.schema.json (FND-03).
//
//   node scripts/generate.mts          write the generated files
//   node scripts/generate.mts --check  fail if a generated file is missing or out of date (CI)
//
// Outputs (all checked in, never edited by hand):
//   src/generated/contracts.ts     one exported type per schema $defs entry
//   src/generated/constants.ts     versions, method names and error codes from the schema
//   test/examples.generated.ts     every valid example, type-checked against its generated type

import { readFileSync, readdirSync, writeFileSync, mkdirSync, existsSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { compile, type JSONSchema } from "json-schema-to-typescript";
import * as prettier from "prettier";

const pkg = resolve(import.meta.dirname, "..");
const contracts = resolve(pkg, "../../contracts");
const schemaPath = join(contracts, "schemas/codeatlas.schema.json");
const examplesDir = join(contracts, "fixtures/examples");
const check = process.argv.includes("--check");

const BANNER =
    "// GENERATED by packages/contracts/scripts/generate.mts from contracts/schemas/codeatlas.schema.json.\n// Do not edit by hand: change the schema and run `npm run generate`.\n";

type Defs = Record<string, JSONSchema & { enum?: unknown[]; "x-names"?: string[] }>;
const schema = JSON.parse(readFileSync(schemaPath, "utf8")) as JSONSchema & {
    $defs: Defs;
    "x-contract-version": string;
    "x-protocol-version": string;
};

async function contractTypes(): Promise<string> {
    const ts = await compile(schema, "CodeAtlasContracts", {
        bannerComment: "",
        unreachableDefinitions: true,
        additionalProperties: false,
        strictIndexSignatures: true,
        declareExternallyReferenced: true,
        format: true,
        style: { printWidth: 110, singleQuote: false, trailingComma: "all" },
    });
    const cleaned = ts
        // Drop the generator's "referenced by CodeAtlasContracts via definition X" notes.
        .replace(
            /\/\*\*\n \* This interface was referenced by `CodeAtlasContracts`'s JSON-Schema\n \* via the `definition` "[^"]*"\.\n \*\/\n/g,
            "",
        )
        .replace(
            /\n \*\n \* This interface was referenced by `CodeAtlasContracts`'s JSON-Schema\n \* via the `definition` "[^"]*"\./g,
            "",
        )
        // The bundle root only groups $defs; drop the empty root interface emitted for it.
        .replace(/(\/\*\*(?:(?!\*\/)[\s\S])*\*\/\n)?export interface CodeAtlasContracts \{[\s\S]*?\n\}\n/, "");
    if (cleaned.includes("CodeAtlasContracts")) throw new Error("could not remove the root interface or its notes");
    return BANNER + "\n" + cleaned.trimStart();
}

function constantName(value: string): string {
    return value
        .replace(/^\$\//, "")
        .replace(/[^A-Za-z0-9]+/g, "_")
        .replace(/([a-z])([A-Z])/g, "$1_$2")
        .toUpperCase();
}

function constants(): string {
    const defs = schema.$defs;
    const strings = (name: string) => (defs[name]?.enum ?? []) as string[];
    const methods = [...strings("RequestMethod"), ...strings("NotificationMethod")];
    const codes = (defs.ErrorCode?.enum ?? []) as number[];
    const names = defs.ErrorCode?.["x-names"] ?? [];
    if (codes.length === 0 || codes.length !== names.length)
        throw new Error("ErrorCode enum and x-names must have the same length");
    const lines = [
        BANNER,
        `/** Version of the contract bundle (\`x-contract-version\`). */`,
        `export const CONTRACT_VERSION = ${JSON.stringify(schema["x-contract-version"])} as const;`,
        "",
        `/** JSON-RPC protocol version (\`x-protocol-version\`). */`,
        `export const PROTOCOL_VERSION = ${JSON.stringify(schema["x-protocol-version"])} as const;`,
        "",
        `/** JSON-RPC method names (\`RequestMethod\` and \`NotificationMethod\`). */`,
        "export const Method = {",
        ...methods.map((m) => `  ${constantName(m)}: ${JSON.stringify(m)},`),
        "} as const;",
        "",
        `/** JSON-RPC error codes (\`ErrorCode\`; names from \`x-names\`). */`,
        "export const ErrorCode = {",
        ...names.map((n, i) => `  ${n}: ${codes[i]},`),
        "} as const;",
        "",
    ];
    return lines.join("\n");
}

function exampleTypes(): string {
    const types = readdirSync(examplesDir, { withFileTypes: true })
        .filter((d) => d.isDirectory())
        .map((d) => d.name)
        .sort();
    const lines = [
        BANNER.replace("from contracts/schemas/codeatlas.schema.json", "from contracts/fixtures/examples"),
        "// Compile-time check: every valid example is assignable to its generated type (excess-property checks included).",
        "",
        `import type { ${types.join(", ")} } from "../src/index.js";`,
        "",
    ];
    for (const type of types) {
        const files = readdirSync(join(examplesDir, type))
            .filter((f) => f.startsWith("valid-") && f.endsWith(".json"))
            .sort();
        for (const file of files) {
            const value = JSON.parse(readFileSync(join(examplesDir, type, file), "utf8"));
            const id = `${type}_${file
                .replace(/^valid-/, "")
                .replace(/\.json$/, "")
                .replace(/[^A-Za-z0-9]+/g, "_")}`;
            lines.push(`// ${type}/${file}`, `export const ${id}: ${type} = ${JSON.stringify(value, null, 2)};`, "");
        }
    }
    return lines.join("\n");
}

// Format with the repository's Prettier config, so generated files look like hand-written ones
// and the --check comparison matches what an editor's format-on-save produces.
async function format(rel: string, source: string): Promise<string> {
    const filepath = join(pkg, rel);
    const options = (await prettier.resolveConfig(filepath)) ?? {};
    return prettier.format(source, { ...options, filepath, endOfLine: "lf" });
}

const outputs: Record<string, string> = {
    "src/generated/contracts.ts": await format("src/generated/contracts.ts", await contractTypes()),
    "src/generated/constants.ts": await format("src/generated/constants.ts", constants()),
    "test/examples.generated.ts": await format("test/examples.generated.ts", exampleTypes()),
};

let stale = 0;
for (const [rel, content] of Object.entries(outputs)) {
    const file = join(pkg, rel);
    const current = existsSync(file) ? readFileSync(file, "utf8").replace(/\r\n/g, "\n") : null;
    if (check) {
        if (current !== content) {
            console.error(`out of date: packages/contracts/${rel}`);
            stale++;
        }
    } else if (current !== content) {
        mkdirSync(dirname(file), { recursive: true });
        writeFileSync(file, content);
        console.log(`wrote packages/contracts/${rel}`);
    }
}
if (stale > 0) {
    console.error(
        "Generated contract files are stale. Run `npm run generate` in packages/contracts and commit the result.",
    );
    process.exit(1);
}
if (check) console.log("Generated contract files are up to date.");
