{
  "$schema": "../scenario.schema.json",
  "port": "SnapshotStore",
  "title": "Snapshots are immutable: a second save with the same id is rejected and changes nothing",
  "given": [
    "synchrostream-2"
  ],
  "steps": [
    {
      "op": "save",
      "seed": "synchrostream-2-conflict",
      "expect": {
        "error": "already_exists"
      }
    },
    {
      "op": "get",
      "snapshotId": "snap-synchrostream-0002",
      "expect": {
        "snapshot": "synchrostream-2"
      }
    }
  ]
}
