{
  "$schema": "../scenario.schema.json",
  "port": "SnapshotStore",
  "title": "Deleting a snapshot removes it and nothing else",
  "given": [
    "synchrostream-1",
    "synchrostream-2"
  ],
  "steps": [
    {
      "op": "delete",
      "snapshotId": "snap-synchrostream-0002",
      "expect": {
        "ok": true
      }
    },
    {
      "op": "get",
      "snapshotId": "snap-synchrostream-0002",
      "expect": {
        "error": "not_found"
      }
    },
    {
      "op": "get",
      "snapshotId": "snap-synchrostream-0001",
      "expect": {
        "snapshot": "synchrostream-1"
      }
    },
    {
      "op": "delete",
      "snapshotId": "snap-synchrostream-0002",
      "expect": {
        "error": "not_found"
      }
    },
    {
      "op": "list",
      "params": {
        "repository": "synchrostream"
      },
      "expect": {
        "snapshotIds": [
          "snap-synchrostream-0001"
        ]
      }
    },
    {
      "op": "latest",
      "repository": "synchrostream",
      "expect": {
        "snapshotId": "snap-synchrostream-0001"
      }
    }
  ]
}
