{
  "$schema": "../scenario.schema.json",
  "port": "SnapshotStore",
  "title": "Listing returns newest first, ties broken by snapshot id, filtered and limited",
  "given": [
    "synchrostream-1",
    "synchrostream-2",
    "synchrostream-3-failed",
    "codeatlas-demo-1"
  ],
  "steps": [
    {
      "op": "list",
      "params": {},
      "expect": {
        "snapshotIds": [
          "snap-synchrostream-0003",
          "snap-codeatlas-demo-0001",
          "snap-synchrostream-0002",
          "snap-synchrostream-0001"
        ]
      }
    },
    {
      "op": "list",
      "params": {
        "repository": "synchrostream"
      },
      "expect": {
        "snapshotIds": [
          "snap-synchrostream-0003",
          "snap-synchrostream-0002",
          "snap-synchrostream-0001"
        ]
      }
    },
    {
      "op": "list",
      "params": {
        "repository": "synchrostream",
        "limit": 2
      },
      "expect": {
        "snapshotIds": [
          "snap-synchrostream-0003",
          "snap-synchrostream-0002"
        ]
      }
    },
    {
      "op": "list",
      "params": {
        "repository": "unknown-repository"
      },
      "expect": {
        "snapshotIds": []
      }
    }
  ]
}
