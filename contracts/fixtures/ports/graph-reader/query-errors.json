{
  "$schema": "../scenario.schema.json",
  "port": "GraphReader",
  "title": "Queries report unknown snapshots, unfinished snapshots and unknown nodes",
  "given": [
    "synchrostream-2",
    "synchrostream-3-failed"
  ],
  "steps": [
    {
      "op": "query",
      "snapshotId": "snap-does-not-exist",
      "query": {
        "kind": "find_symbols",
        "text": "join"
      },
      "expect": {
        "error": "snapshot_not_found"
      }
    },
    {
      "op": "query",
      "snapshotId": "snap-synchrostream-0003",
      "query": {
        "kind": "find_symbols",
        "text": "party"
      },
      "expect": {
        "error": "snapshot_not_complete"
      }
    },
    {
      "op": "query",
      "snapshotId": "snap-synchrostream-0002",
      "query": {
        "kind": "callers",
        "nodeId": "symbol:does/not/exist.ts#missing"
      },
      "expect": {
        "error": "node_not_found"
      }
    }
  ]
}
